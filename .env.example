# Server-only placeholders. Never put a real credential in this tracked file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Comma-separated extra origins. The request's own origin is always accepted.
ALLOWED_APP_ORIGINS=http://localhost:3000
SUBMISSIONS_ENABLED=false
REWARD_PROVIDER=disabled
# Set REWARD_PROVIDER=kinema_manual only after all three server-only values exist.
KINEMA_FILM_URL=https://kinema.com/films/private-film-slug
KINEMA_CLIMATE_WEEK_NYC_2026_CODE=replace_me
KINEMA_COLUMBIA_CLIMATE_SCHOOL_2026_CODE=replace_me
DATASET_ENV=preview

# Browser-safe campaign CTA.
NEXT_PUBLIC_PROJECT_RESET_SIGNUP_URL=https://projectreset.example/signup
NEXT_PUBLIC_DONATE_URL=https://thirddegreeburnout.com/donate
NEXT_PUBLIC_PROJECT_RESET_TRAILER_URL=https://www.thirddegreeburnout.com/

# Browser-safe values used only for the PII-free aggregate revision subscription.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
